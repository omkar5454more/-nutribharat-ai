# Copy to .env and fill in from your Supabase project (Project Settings -> API). The publishable/anon key is safe to ship in the app;
# NEVER put the service-role key or the Anthropic key here — the Anthropic key is a Supabase Edge Function secret.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
